# ACG Blog 生产环境配置
# 复制此文件为 .env 并修改对应值

# 应用配置
APP_NAME=ACG Blog
APP_VERSION=1.0.0
DEBUG=false

# 数据库配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=acg_blog

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# JWT 配置 (请修改为随机字符串)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 配置 (前端域名)
BACKEND_CORS_ORIGINS=http://localhost,https://your-domain.com
